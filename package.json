{
  "name": "hive",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p packages/contracts && tsc --noEmit -p packages/db && tsc --noEmit -p apps/api-worker && tsc --noEmit -p apps/executor && tsc --noEmit -p apps/cli",
    "lint": "oxlint . --deny-warnings",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "db:generate": "bun run --cwd packages/db db:generate",
    "db:check": "bun run --cwd packages/db db:check"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "typescript": "latest",
    "vitest": "^4.1.10"
  },
  "packageManager": "bun@1.4.3"
}
