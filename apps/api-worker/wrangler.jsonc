{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hive-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  // Production uses workers.dev; Access protects this host and, after the second apply, every preview URL (infra/).
  "workers_dev": true,
  "preview_urls": true,
  // Outbox pump (src/pump.ts) until Cloudflare Queues carry the outbox.
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hive",
      // PLACEHOLDER: replace with terraform output `d1_database_id` (infra/README.md).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/db/migrations",
    },
  ],
  // Transcript parts and other objects (src/transcripts.ts). The bucket is created by Terraform (infra/).
  "r2_buckets": [{ "binding": "R2", "bucket_name": "hive" }],
  // Realtime DO (src/realtime.ts): one per Workspace, WebSocket connections only.
  "durable_objects": { "bindings": [{ "name": "REALTIME", "class_name": "Realtime" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Realtime"] }],
  "vars": {
    // Cloudflare Access team domain, e.g. "<team>.cloudflareaccess.com" (no scheme).
    "ACCESS_TEAM_DOMAIN": "",
    // Application Audience (AUD) tag of the Access application protecting this Worker.
    "ACCESS_AUD": "",
  },
}
